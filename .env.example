# Copy this to .env on the VPS and fill in real values.
# .env is gitignored — never commit it.

# --- Required ---
# Shared login password for the estimator (single shared login, like CSC).
APP_PASSWORD=change-me
# Random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# --- Optional: AI visualizer (stain/seal preview) ---
# Without this, the Visualizer feature is disabled but everything else works.
OPENAI_API_KEY=sk-proj-...

# --- Optional: Housecall Pro sync ---
# Without these, estimates save locally and the "Send to Housecall Pro" button is disabled.
# Public API requires a Housecall Pro MAX plan.
HCP_API_KEY=
# Base URL rarely changes; override only if HCP tells you to.
HCP_API_BASE=https://api.housecallpro.com/v1

# --- Service config ---
PORT=3000
NODE_ENV=production
