[Unit]
Description=Chicago Deck Expert Estimator (Node app)
After=network.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to match your VPS layout.
User=www-data
WorkingDirectory=/var/www/deck-expert-estimator
EnvironmentFile=/var/www/deck-expert-estimator/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
